# SmartCart frontend - environment variables
#
# Copy this file to .env and fill in the values.
#
#   cp .env.example .env      (Git Bash / macOS / Linux)
#   copy .env.example .env    (Windows cmd)
#
# Vite only exposes variables that start with VITE_ to the browser.
# Anything without that prefix stays private to the build process.

# -----------------------------------------------------------------
# The URL of the Flask backend
# -----------------------------------------------------------------
#
# Local development - the backend on your own machine:
#   VITE_API_URL=http://127.0.0.1:5000
#
# If you deploy the frontend but keep the backend on your laptop,
# 127.0.0.1 will NOT work: the browser interprets it as "this
# machine", meaning wherever the visitor is, not where your server
# is. You would need a public URL for the backend instead.
VITE_API_URL=http://127.0.0.1:5000
