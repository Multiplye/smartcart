{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "buildCommand": "cd smartcart/smartcart && npm install && npm run build",
  "outputDirectory": "smartcart/smartcart/dist",
  "installCommand": "echo skip-root-install",
  "framework": null,
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
