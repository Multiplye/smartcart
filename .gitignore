# ---- Python ----
backend/venv/
__pycache__/
*.pyc
*.pyo
*.pyd

# ---- Node ----
node_modules/
dist/
dist-ssr/
*.local

# ---- Database ----
# The database is NOT shared. It holds real uploaded data and, once
# users register, real password hashes. Each developer keeps their own
# local copy and re-seeds it with:  python import_products.py
*.db
*.sqlite
*.sqlite3

# Safety copies of the database. These are made before any script that
# deletes rows, and they end in .bak-... rather than .db - so the *.db
# rule above did NOT match them and they were one `git add -A` away
# from being committed with the password hashes inside.
*.db.bak*
*.bak-before-*

# ---- Secrets ----
.env
.env.local
.env.*.local

# ---- Editors / OS ----
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# ---- Logs ----
*.log
npm-debug.log*
