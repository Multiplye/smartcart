# ---- Python ----
backend/venv/
__pycache__/
*.pyc
*.pyo
*.pyd

# ---- Node ----
node_modules/
dist/
dist-ssr/
*.local

# ---- Database ----
# The database is NOT shared. It holds real uploaded data and, once
# users register, real password hashes. Each developer keeps their own
# local copy and re-seeds it with:  python import_products.py
*.db
*.sqlite
*.sqlite3

# Safety copies of the database. These are made before any script that
# deletes rows, and they end in .bak-... rather than .db - so the *.db
# rule above did NOT match them and they were one `git add -A` away
# from being committed with the password hashes inside.
*.db.bak*
*.bak-before-*

# ---- Secrets ----
# Ignore every .env file...
.env
.env.local
.env.*.local
**/.env

# ...but keep the template. Anyone cloning the repo needs to know which
# variables the project expects, and .env.example contains no real
# values - only placeholders. Without the exception below, the bare
# ".env" rule would also hide the template, because ".env.example"
# starts with ".env".
!.env.example
!**/.env.example

# ---- Editors / OS ----
# ".vscode/*" ignores the folder's contents, and "!.vscode/settings.json"
# re-includes the one file worth sharing: it tells VS Code to show the
# git-ignored database and to use the backend virtual environment.
# Without this exception the settings file is ignored and a fresh clone
# loses both behaviours.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# ---- Logs ----
*.log
npm-debug.log*

# ---- Local tooling binaries ----
# tools/cloudflared.exe is a 55 MB download used to expose the local
# backend during development. It is not source code and should never be
# committed - git would store a full copy in history forever, and it is
# platform-specific (Windows only).
#
# Keep the helper scripts, ignore the binaries they download.
tools/*.exe
tools/*.zip
tools/cloudflared*
